:1807,"c":44},{"n":55,"bn":"বাই'আত","en":"The Oath of Allegiance","f":1808,"l":1810,"c":3},{"n":56,"bn":"কথাবার্তা","en":"Speech","f":1811,"l":1838,"c":28},{"n":57,"bn":"জাহান্নাম","en":"Jahannam","f":1839,"l":1840,"c":2},{"n":58,"bn":"সাদকা","en":"Sadaqa","f":1841,"l":1855,"c":15},{"n":59,"bn":"ইলম (জ্ঞান)","en":"Knowledge","f":1856,"l":1856,"c":1},{"n":60,"bn":"মজলুমের দোয়া","en":"The Supplication of the Unjustly Wronged","f":1857,"l":1857,"c":1},{"n":61,"bn":"নবী (সা.)-এর নামসমূহ","en":"The Names of the Prophet, may Allah Bless Him and Grant Him Peace","f":1858,"l":1858,"c":1}],"life":"জন্ম: ৯৩ হিজরি (৭১১ খ্রি.), মদিনা • মৃত্যু: ১৭৯ হিজরি (৭৯৫ খ্রি.), মদিনা (জান্নাতুল বাকীতে সমাহিত)","bio":"ইমাম মালিক ইবনু আনাস (রহ.) \"দারুল হিজরাহর ইমাম\" নামে পরিচিত এবং মালিকী মাযহাবের প্রতিষ্ঠাতা। সারা জীবন মদিনায় কাটিয়েছেন, হজ ছাড়া মদিনা ছেড়ে কোথাও যাননি। রাসূল (সা.)-এর শহরের সম্মানে মদিনায় কখনো বাহনে চড়তেন না বলে বর্ণিত আছে। তাঁর \"মুয়াত্তা\" হাদিসের সবচেয়ে প্রাচীন সংকলনগুলোর একটি, যা তিনি প্রায় চল্লিশ বছর ধরে পরিমার্জন করেন। ইমাম শাফেঈ (রহ.) ছিলেন তাঁর ছাত্র।"},{"key":"nawawi","bn":"চল্লিশ হাদিস (নববী)","en":"40 Hadith of an-Nawawi","author":"ইমাম ইয়াহইয়া ইবনু শারাফ আন-নববী (রহ.)","total":42,"sections":[{"n":1,"bn":"চল্লিশ হাদিস","en":"Forty Hadith of an-Nawawi","f":1,"l":42,"c":42}],"life":"জন্ম: ৬৩১ হিজরি (১২৩৩ খ্রি.), নাওয়া (বর্তমান সিরিয়া) • মৃত্যু: ৬৭৬ হিজরি (১২৭৭ খ্রি.), নাওয়া","bio":"ইমাম আবু যাকারিয়া ইয়াহইয়া ইবনু শারাফ আন-নববী (রহ.) শাফেঈ মাযহাবের অন্যতম শ্রেষ্ঠ আলেম। আঠারো বছর বয়সে দামেস্কে গিয়ে ইলম অর্জন করেন এবং অত্যন্ত সাদাসিধে, দুনিয়াবিমুখ জীবন যাপন করেন। মাত্র পঁয়তাল্লিশ বছরের জীবনে তিনি \"রিয়াদুস সালেহীন\", \"আল-আযকার\", \"সহীহ মুসলিমের ব্যাখ্যা\"সহ বহু অমূল্য গ্রন্থ রেখে যান। তাঁর \"চল্লিশ হাদিস\" (আসলে ৪২টি) দ্বীনের মৌলিক বিষয়গুলো সংক্ষেপে জানার জন্য সারা বিশ্বে পড়া হয়।"}]